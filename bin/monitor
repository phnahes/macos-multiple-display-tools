#!/usr/bin/env bash
#
# monitor — control brightness, contrast and volume of external monitors on
# macOS via DDC/CI, and show which port the monitor is connected to.
#
# The same file serves several names (symlinks created by install.sh):
#   monitor, brightness, contrast, monitor-info
#   brilho, contraste (Portuguese aliases)
#
set -euo pipefail

VERSION="1.0.0"

M1DDC_BIN="${M1DDC_BIN:-m1ddc}"
MONITOR_NAME="${MONITOR_NAME:-ARZOPA}"
MONITOR_ID="${MONITOR_ID:-}"
MIN=0
MAX=100

die()  { printf 'monitor: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

require_m1ddc() {
  have "$M1DDC_BIN" || die "m1ddc not found. Install it with: brew install m1ddc"
}

# ---------------------------------------------------------------------------
# Display resolution
# ---------------------------------------------------------------------------

display_list() { "$M1DDC_BIN" display list 2>/dev/null; }

resolve_display() {
  if [ -n "$MONITOR_ID" ]; then
    printf '%s\n' "$MONITOR_ID"
    return 0
  fi

  local list id
  list="$(display_list)" || die "could not run '$M1DDC_BIN display list'"
  [ -n "$list" ] || die "no displays found"

  id="$(printf '%s\n' "$list" | awk -v name="$MONITOR_NAME" '
    index(tolower($0), tolower(name)) && match($0, /^\[[0-9]+\]/) {
      print substr($0, 2, RLENGTH - 2)
      exit
    }')"

  if [ -z "$id" ]; then
    # If there is only one display (Mac mini, iMac with no extra monitor), use it.
    if [ "$(printf '%s\n' "$list" | wc -l | tr -d ' ')" -eq 1 ]; then
      printf '%s\n' "$list" | sed -n 's/^\[\([0-9]*\)\].*/\1/p'
      return 0
    fi
    printf 'monitor: no display named "%s".\n\nDisplays found:\n%s\n\nSet MONITOR_NAME or MONITOR_ID.\n' \
      "$MONITOR_NAME" "$list" >&2
    return 1
  fi

  printf '%s\n' "$id"
}

# ---------------------------------------------------------------------------
# DDC reads and writes
# ---------------------------------------------------------------------------

get_value() {
  local id="$1" feat="$2" raw
  raw="$("$M1DDC_BIN" display "$id" get "$feat" 2>/dev/null)" || return 1
  raw="$(printf '%s' "$raw" | tr -cd '0-9')"
  [ -n "$raw" ] || return 1
  printf '%s\n' "$raw"
}

set_value() {
  local id="$1" feat="$2" value="$3"
  "$M1DDC_BIN" display "$id" set "$feat" "$value" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

change() {
  local feat="$1"
  shift
  require_m1ddc

  local id cur arg n new
  id="$(resolve_display)" || exit 1
  cur="$(get_value "$id" "$feat")" ||
    die "the monitor did not answer '$feat'. DDC/CI unavailable or monitor disconnected."

  arg="${1:-}"
  case "$arg" in
    ''|get)
      printf '%s\n' "$cur"
      return 0
      ;;
    max) new=$MAX ;;
    min) new=$MIN ;;
    +[0-9]*)
      n="${arg#+}"; [ -z "${n//[0-9]/}" ] || die "invalid value: $arg"
      new=$(( cur + n ))
      ;;
    -[0-9]*)
      n="${arg#-}"; [ -z "${n//[0-9]/}" ] || die "invalid value: $arg"
      new=$(( cur - n ))
      ;;
    [0-9]*)
      [ -z "${arg//[0-9]/}" ] || die "invalid value: $arg"
      new=$arg
      ;;
    *)
      die "invalid value: $arg (use 0-100, +N, -N, max or min)"
      ;;
  esac

  if [ "$new" -lt "$MIN" ]; then new=$MIN; fi
  if [ "$new" -gt "$MAX" ]; then new=$MAX; fi

  set_value "$id" "$feat" "$new" || die "could not write '$feat' to the monitor"
  printf '%s\n' "$new"
}

# ---------------------------------------------------------------------------
# Physical port
# ---------------------------------------------------------------------------

# Maps the internal USB-C port number to its physical position (left/right).
# The internal numbering does not follow the visual order, so we read ioreg.
usbc_locations() {
  ioreg -r -c AppleARMSPMIDevice -l -w0 2>/dev/null | awk '
    function hex2dec(h,   i, c, v) {
      v = 0; h = tolower(h)
      for (i = 1; i <= length(h); i++) {
        c = substr(h, i, 1)
        v = v * 16 + index("0123456789abcdef", c) - 1
      }
      return v
    }
    function emit() {
      if (loc != "" && num != "") print num " " loc
    }
    /\+-o hpm[0-9]+@/ {
      emit()
      num = ""; loc = ""
      next
    }
    /"port-number"/ {
      v = $0; sub(/.*</, "", v); sub(/>.*/, "", v)
      gsub(/0/, "", v)
      num = hex2dec(v)
    }
    /"port-location"/ {
      v = $0; sub(/.*<"/, "", v); sub(/">.*/, "", v)
      loc = v
    }
    END { emit() }'
}

# Describes the active transport's port: "USB-C 2 (left, rear)" etc.
port_label() {
  local desc="$1" num where
  case "$desc" in
    Port-HDMI*) printf 'HDMI' ;;
    Port-USB-C@*)
      num="${desc#Port-USB-C@}"
      num="${num%%/*}"
      where="$(usbc_locations | awk -v n="$num" '$1 == n { print $2; exit }')"
      case "$where" in
        left-front) where="USB-C $num (left, front)" ;;
        left-rear)  where="USB-C $num (left, rear)" ;;
        right)      where="USB-C $num (right)" ;;
        '')         where="USB-C $num" ;;
        *)          where="USB-C $num ($where)" ;;
      esac
      printf '%s' "$where"
      ;;
    *)
      printf '%s' "${desc%%/*}"
      ;;
  esac
}

# Prints the active link: desc|rate|lanes|product
active_link() {
  ioreg -r -c IOPortTransportStateDisplayPort -l -w0 2>/dev/null | awk '
    /\+-o DisplayPort/ {
      emit(); desc = ""; act = ""; rate = ""; lanes = ""; prod = ""
      next
    }
    /"TransportDescription"/ { v = $0; sub(/.*= "/, "", v); sub(/"$/, "", v); desc = v }
    /"Active" = Yes/         { act = "yes" }
    /"LinkRateDescription"/  { v = $0; sub(/.*= "/, "", v); sub(/"$/, "", v); rate = v }
    /"LaneCount"/ && lanes == "" { v = $0; sub(/.*= /, "", v); lanes = v }
    /"ProductName"/ && prod == "" { v = $0; sub(/.*= "/, "", v); sub(/"$/, "", v); prod = v }
    function emit() {
      if (act == "yes") print desc "|" rate "|" lanes "|" prod
    }
    END { emit() }'
}

show_info() {
  local line desc rate lanes prod val

  if have "$M1DDC_BIN"; then
    printf 'Displays:\n'
    display_list | sed 's/^/  /'
    printf '\n'
  else
    printf 'm1ddc: not installed (brew install m1ddc)\n\n'
  fi

  line="$(active_link | head -n 1)"
  if [ -n "$line" ]; then
    IFS='|' read -r desc rate lanes prod <<< "$line"
    printf 'Monitor:    %s\n' "${prod:-unknown}"
    printf 'Connection: %s\n' "$(port_label "$desc")"
    printf 'Link:       %s, %s lanes\n\n' "${rate:-?}" "${lanes:-?}"
  else
    printf 'Connection: no active external monitor\n\n'
  fi

  if have "$M1DDC_BIN"; then
    local id
    if id="$(resolve_display 2>/dev/null)"; then
      for feat in luminance:Brightness contrast:Contrast volume:Volume; do
        if val="$(get_value "$id" "${feat%%:*}")"; then
          printf '%s: %s\n' "${feat##*:}" "$val"
        else
          printf '%s: —\n' "${feat##*:}"
        fi
      done
    fi
  fi
}

usage() {
  cat <<'EOF'
monitor — control external monitors on macOS (DDC/CI)

Usage:
  monitor brightness [value | +N | -N | max | min | get]
  monitor contrast   [value | +N | -N | max | min | get]
  monitor volume     [value | +N | -N | max | min | get]
  monitor info
  monitor list
  monitor help

Shorthands (symlinks):
  brightness [value | +N | -N]   same as monitor brightness
  contrast [...]                 same as monitor contrast
  monitor-info                   same as monitor info

Examples:
  brightness        # print the current brightness
  brightness 60     # set 60%
  brightness +10    # increase by 10 points
  brightness -10    # decrease by 10 points
  contrast 75
  monitor info      # displays, physical port, link and current values

Environment:
  MONITOR_NAME  monitor name in the m1ddc list (default: ARZOPA)
  MONITOR_ID    fixed display index, ignores MONITOR_NAME
  M1DDC_BIN     path to the m1ddc binary (default: m1ddc in PATH)

Numeric output (0-100) for scripting.
EOF
}

main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  case "$cmd" in
    brightness|brilho|luminance|lum) change luminance "$@" ;;
    contrast|contraste)              change contrast "$@" ;;
    volume|som)                      change volume "$@" ;;
    info|status)                     show_info ;;
    list|displays)                   require_m1ddc; display_list ;;
    help|--help|-h)                  usage ;;
    version|--version)               printf '%s\n' "$VERSION" ;;
    *)                               usage; exit 1 ;;
  esac
}

prog="$(basename -- "$0")"
case "$prog" in
  brightness|brilho) main brightness "$@" ;;
  contrast|contraste) main contrast "$@" ;;
  monitor-info)       main info "$@" ;;
  *)                  main "$@" ;;
esac
